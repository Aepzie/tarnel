{
  "name": "vela",
  "productName": "Vela",
  "version": "0.8.3",
  "description": "A fast, quiet, ultra-clean browser with isolated multi-session Spaces.",
  "main": "dist/main/index.js",
  "license": "MIT",
  "author": "Vela contributors",
  "homepage": "https://github.com/Aepzie/vela",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aepzie/vela.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "icons": "electron scripts/icons.mjs",
    "dist": "node scripts/build.mjs --production && electron-builder",
    "dist:dir": "node scripts/build.mjs --production && electron-builder --dir"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "^6.8.11"
  }
}
